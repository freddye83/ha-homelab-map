{
  "tasks": {
    "test": "deno run --frozen --allow-read --allow-write=test/out test/run.js"
  },
  "fmt": {
    "lineWidth": 160,
    "include": [
      "dist/ha-homelab-map.js",
      "dist/ha-homelab-map-editor.js",
      "test/*.js"
    ]
  },
  "lint": {
    "include": [
      "dist/ha-homelab-map.js",
      "dist/ha-homelab-map-editor.js"
    ],
    "rules": {
      "exclude": [
        "no-window",
        "no-window-prefix"
      ]
    }
  }
}
